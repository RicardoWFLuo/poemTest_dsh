  poet: "\u674E\u5CE4"
  poemContent: "\u89E3\u843D\u4E09\u79CB\u53F6\uFF0C\n\u80FD\u5F00\u4E8C\u6708\u82B1\u3002\n\u8FC7\u6C5F\u5343\u5C3A\u6D6A\uFF0C\n\u5165\u7AF9\u4E07\u7AFF\u659C\u3002"
  promptText: "\u8BF7\u4E3A\u513F\u7AE5\u8BE6\u7EC6\u89E3\u91CA\u8FD9\u9996\u53E4\u8BD7\uFF0C\u8BED\u8A00\u7B80\u5355\u6613\u61C2\uFF0C\u6E29\u67D4\u53EF\u7231\u3002"
