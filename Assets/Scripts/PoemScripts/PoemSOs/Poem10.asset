  poemTitle: "\u5C0F\u513F\u5782\u9493"
  poet: "\u80E1\u4EE4\u80FD"
  poemContent: "\u84EC\u5934\u7A1A\u5B50\u5B66\u5782\u7EB6\uFF0C\n\u4FA7\u5750\u8393\u82D4\u8349\u6620\u8EAB\u3002\n\u8DEF\u4EBA\u501F\u95EE\u9065\u62DB\u624B\uFF0C\n\u6015\u5F97\u9C7C\u60CA\u4E0D\u5E94\u4EBA\u3002"
  promptText: "\u8BF7\u4E3A\u513F\u7AE5\u8BE6\u7EC6\u89E3\u91CA\u8FD9\u9996\u53E4\u8BD7\uFF0C\u8BED\u8A00\u7B80\u5355\u6613\u61C2\uFF0C\u6E29\u67D4\u53EF\u7231\u3002"
