  poemContent: "\u6625\u7720\u4E0D\u89C9\u6653\uFF0C\n\u5904\u5904\u95FB\u557C\u9E1F\u3002\n\u591C\u6765\u98CE\u96E8\u58F0\uFF0C\n\u82B1\u843D\u77E5\u591A\u5C11\u3002"
